rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Media is public-read (signed-in), owner-write. Upload paths in the app:
    // avatars/{uid}.jpg, posts/{uid}/{millis}.jpg, stories/{uid}/{millis}.jpg,
    // reels/{uid}/{millis}.mp4 — the seeder uploads via the admin SDK and
    // bypasses these rules entirely.
    match /avatars/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && fileName == request.auth.uid + '.jpg';
    }

    match /{folder}/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && uid == request.auth.uid
        && folder in ['posts', 'stories', 'reels'];
    }
  }
}
