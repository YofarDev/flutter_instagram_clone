rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      // owner edits anything; strangers may ONLY touch the count fields
      // (follow batches increment counts on both user docs)
      allow update: if request.auth.uid == uid ||
          (signedIn() && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['followerCount', 'followingCount']));
      allow delete: if false;

      match /followers/{followerUid} {
        allow read: if signedIn();
        allow create, delete: if signedIn() && request.auth.uid == followerUid;
      }

      match /following/{targetUid} {
        allow read: if signedIn();
        allow create, delete: if signedIn() && request.auth.uid == uid;
      }
    }

    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;

      match /viewers/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == uid;
      }
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      // strangers may only flip like/comment counts (transactions)
      allow update: if request.auth.uid == resource.data.authorId ||
          (signedIn() && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['likeCount', 'commentCount']));
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

      match /likes/{uid} {
        allow read: if signedIn();
        allow create, delete: if signedIn() && request.auth.uid == uid;
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if signedIn() && resource.data.authorId == request.auth.uid;
      }
    }

    match /reels/{reelId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      // strangers may only flip likeCount/commentCount
      allow update: if signedIn() && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['likeCount', 'commentCount']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;

      match /likes/{uid} {
        allow read: if signedIn();
        allow create, delete: if signedIn() && request.auth.uid == uid;
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /savedPosts/{id} {
      // doc id is {uid}_{postId}; owner-only reads and writes
      allow read, create, delete: if signedIn() &&
          resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /notifications/{id} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      // ponytail: still client-writable, but no impersonation (actorId must be
      // the caller) and no self-notifications; server-side writes later
      allow create: if signedIn() &&
          request.resource.data.actorId == request.auth.uid &&
          request.resource.data.ownerUid != request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /conversations/{convId} {
      // get() on a missing doc denies on resource.data, so allow the read
      // when the doc doesn't exist yet (getOrCreateConversation probes first)
      allow read: if signedIn() &&
          (!exists(/databases/$(database)/documents/conversations/$(convId)) ||
           request.auth.uid in resource.data.participants);
      allow create: if signedIn() &&
          request.auth.uid in request.resource.data.participants;
      // participants may only bump lastMessage/updatedAt, repair
      // participantMeta (race-path merge-sets touch it), and flag typing
      allow update: if signedIn() &&
          request.auth.uid in resource.data.participants &&
          request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['lastMessage', 'updatedAt', 'participantMeta', 'typingUid']);
      allow delete: if false;

      match /messages/{mid} {
        allow read: if signedIn() && request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow create: if signedIn() &&
            request.resource.data.senderId == request.auth.uid &&
            request.auth.uid in
                get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        // read receipts: a participant may stamp readAt on messages sent TO
        // them, and may touch nothing else
        allow update: if signedIn() &&
            request.auth.uid in
                get(/databases/$(database)/documents/conversations/$(convId)).data.participants &&
            request.resource.data.senderId == resource.data.senderId &&
            request.resource.data.senderId != request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['readAt']);
        allow delete: if false;
      }
    }
  }
}
